{
  // The build emits the application only. tsconfig.json keeps the tests in the
  // program so `typecheck` still covers them, but they have no business in
  // dist/, where they would ship to production and pull the test runner in.
  "extends": "./tsconfig.json",
  // src/e2e is the API as the browser tests run it, with sign-in and Gmail
  // replaced. It has no business in a deployed image either.
  "exclude": ["src/**/*.test.ts", "src/e2e/**"]
}
