# Campaign Mailer — backend environment
#
# Copy to backend/.env and fill in. Never commit the filled file.
# The process refuses to start when a required variable is missing, so a
# misconfigured deployment fails at boot instead of on the first request that
# needs the value. See backend/src/config/env.ts.
#
# The "needed from" column says which roadmap phase first reads the variable.
# Anything marked Phase 0 is required to boot today.


# ---------------------------------------------------------------------------
# Runtime — Phase 0
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. Railway sets this itself in production.
PORT=3000

# Origin of the web app. CORS is restricted to it, and OAuth redirects back
# through it. No trailing slash.
FRONTEND_URL=http://localhost:5173


# ---------------------------------------------------------------------------
# Database — Phase 0
# ---------------------------------------------------------------------------

# Supabase Postgres connection string, from Project settings > Database.
# Use the connection pooler URI (port 6543) rather than the direct one: the
# API and the worker open connections from separate processes.
# Migrations need the direct URI (port 5432); see DATABASE_DIRECT_URL below.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct connection, used only by migrations. The pooler does not support the
# session-level statements a migration runs.
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres


# ---------------------------------------------------------------------------
# Queue — Phase 4 (the session store reads it from Phase 1)
# ---------------------------------------------------------------------------

# Upstash Redis, the rediss:// URI from the database page.
# BullMQ needs a plain Redis connection, not the REST API.
REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:6379


# ---------------------------------------------------------------------------
# Sessions and encryption — Phase 1
# ---------------------------------------------------------------------------

# Signs the session cookie. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM key protecting the Google tokens at rest. Exactly 32 bytes, hex
# encoded, so 64 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing this key makes every stored token undecryptable and forces every user
# to reconnect their Google account. Keep it in the secret manager, not only
# in this file.
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# Google OAuth and Gmail — Phase 1
# ---------------------------------------------------------------------------

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID,
# type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an authorized redirect URI on that client, character for
# character. In production: https://your-domain/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback


# ---------------------------------------------------------------------------
# Sending limits — Phase 4
# ---------------------------------------------------------------------------

# Hard daily cap per user, enforced by the application. Google allows roughly
# 150 a day on a personal account and 1500 on Workspace; staying under the
# real limit leaves room for the messages the user sends by hand.
GMAIL_DAILY_LIMIT=120

# Milliseconds between two sends, before jitter. Sending in a burst is what
# gets an account flagged.
SEND_PAUSE_MS=3000


# ---------------------------------------------------------------------------
# Attachment storage — Phase 3
# ---------------------------------------------------------------------------

# S3-compatible. Supabase Storage exposes an S3 endpoint under
# Project settings > Storage.
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=eu-west-3
S3_BUCKET=campaign-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------------------
# Observability — Phase 7
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=debug

# Leave empty to disable error reporting.
SENTRY_DSN=
