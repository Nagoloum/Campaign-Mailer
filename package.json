{
  "name": "campaign-mailer",
  "version": "0.1.0",
  "private": true,
  "description": "Web application to create, personalize and send email campaigns at scale from the user's own Gmail account.",
  "author": "Daniel Nagoloum Talla <landhack049@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nagoloum/Campaign-Mailer.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:worker": "npm run dev:worker --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace backend",
    "test:e2e": "npm run test:e2e --workspace backend",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "migrate:latest": "npm run migrate:latest --workspace backend --if-present",
    "migrate:down": "npm run migrate:down --workspace backend --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "oxlint --max-warnings 0"
    ],
    "backend/**/*.ts": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "scripts/**/*.mjs": [
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml,mjs,js}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
