# Campaign Mailer — frontend environment
#
# Copy to frontend/.env and fill in. Never commit the filled file.
#
# Vite exposes only variables prefixed with VITE_, and it inlines them into the
# bundle at build time. Everything here is therefore public: it ships to every
# visitor's browser. No secret, no API key, no token belongs in this file.
# The Google client secret in particular lives on the backend only.


# ---------------------------------------------------------------------------
# Development — Phase 0
# ---------------------------------------------------------------------------

# Where the dev server proxies /api. Read by vite.config.ts at startup, not by
# the application code, so it never reaches the bundle.
# In production the web app and the API sit behind one domain and no proxy runs.
VITE_BACKEND_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Observability — Phase 7
# ---------------------------------------------------------------------------

# Browser-side error reporting. A Sentry DSN is public by design.
# Leave empty to disable.
VITE_SENTRY_DSN=
